{
    "tabWidth": 4,
    "printWidth": 120,
    "semi": true,
    "endOfLine": "auto",
    "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
    "overrides": [
        {
            "files": "*.astro",
            "options": { "parser": "astro" }
        },
        {
            "files": "*.html",
            "options": { "htmlWhitespaceSensitivity": "ignore" }
        }
    ]
}
