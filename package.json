    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc --noEmit false --emitDeclarationOnly --declaration --outDir dist",
        "typecheck": "tsc",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@floating-ui/dom": "^1.8.0",
        "lit": "^3.3.3",
        "lucide": "^1.55.0"
