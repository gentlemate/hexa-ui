---
import css from "hexa-ui/theme.css?raw";
import { parseTheme } from "../theme";
import { baseColors, primaryColors, tokenPresets } from "../theme-presets";
import FontFamilySelect from "./FontFamilySelect.astro";

const defaults = parseTheme(css);

const colors = Object.keys(defaults.dark);
const radii: Record<string, number> = {
    "--hx-radius-control": 2,
    "--hx-radius-field": 2,
    "--hx-radius-option": 2,
    "--hx-radius-panel": 2,
    "--hx-radius-popup": 2,
    "--hx-radius-checkbox": 1,
    "--hx-radius-pill": 1,
};
const sizes: Record<string, [min: number, max: number, step?: number]> = {
    "--hx-height-control": [1.5, 4],
    "--hx-spacing-control": [0.25, 4],
    "--hx-height-field": [1.5, 4],
    "--hx-spacing-field": [0.25, 2],
    "--hx-height-option": [1.25, 3],
    "--hx-spacing-option": [0.125, 1.5, 0.125],
    "--hx-spacing-panel": [0.5, 3],
    "--hx-spacing-popup": [0, 1],
};
const presetDefaults: Record<string, string> = {
    radius: "default",
    size: "default",
    "font-size": "medium",
};

function capitalize(text: string) {
    return text[0].toUpperCase() + text.slice(1);
}

function labelOf(token: string) {
    const words = token.replace("--hx-", "").split("-");
    if (words[0] === "height" || words[0] === "spacing") words.push(words.shift()!);
    if (words[0] === "radius") words.shift();
    return capitalize(words.join(" "));
}

function remOf(token: string) {
    return parseFloat(defaults.light[token]);
}

function presetSelect(preset: string) {
    return {
        preset,
        label: capitalize(preset.replace("-", " ")),
        value: presetDefaults[preset],
        options: Object.keys(tokenPresets[preset]),
    };
}
---

<div class="theme-editor group font-sans">
    <div class="flex flex-col gap-4 group-data-ready:hidden" aria-hidden="true">
        <div class="flex justify-between gap-2">
            <div class="bg-accent rounded-control h-10 w-40 animate-pulse motion-reduce:animate-none"></div>
            <div class="bg-accent rounded-control size-10 animate-pulse motion-reduce:animate-none"></div>
        </div>
        {Array.from({ length: 5 }, () => (
            <div class="bg-accent rounded-control h-16 animate-pulse motion-reduce:animate-none" />
        ))}
    </div>
    <div class="relative hidden group-data-ready:block">
        <hx-tabs value="presets" variant="secondary">
            <hx-tab value="presets">Presets</hx-tab>
            <hx-tab value="tokens">Tokens</hx-tab>

            <hx-tab-panel value="presets">
                <div class="flex flex-col gap-3 pt-2">
                    <hx-form-field label="Base color">
                        <hx-select class="theme-editor-base-color" value="neutral" placeholder="Custom">
                            {baseColors.map((name) => (
                                <hx-select-option value={name}>{capitalize(name)}</hx-select-option>
                            ))}
                        </hx-select>
                    </hx-form-field>
                    <hx-form-field label="Primary color">
                        <hx-select class="theme-editor-primary-color" value="default" placeholder="Custom">
                            <hx-select-option value="default">Neutral</hx-select-option>
                            <hx-select-separator></hx-select-separator>
                            {primaryColors.map((name) => (
                                <hx-select-option value={name}>{capitalize(name)}</hx-select-option>
                            ))}
                        </hx-select>
                    </hx-form-field>
                    {["radius", "size"].map(presetSelect).map(({ preset, label, value, options }) => (
                        <hx-form-field label={label}>
                            <hx-select data-preset={preset} value={value} placeholder="Custom">
                                {options.map((option) => (
                                    <hx-select-option value={option}>{capitalize(option)}</hx-select-option>
                                ))}
                            </hx-select>
                        </hx-form-field>
                    ))}
                    <FontFamilySelect />
                </div>
            </hx-tab-panel>

            <hx-tab-panel value="tokens">
                <hx-accordion collapsible>
                    <hx-accordion-item value="colors">
                        <span slot="title">Colors</span>
                        <div class="flex flex-col gap-3">
                            <hx-tabs class="theme-editor-mode" value="light">
                                <hx-tab value="light">Light</hx-tab>
                                <hx-tab value="dark">Dark</hx-tab>
                            </hx-tabs>
                            {colors.map((token) => (
                                <hx-form-field label={labelOf(token)}>
                                    <hx-color-picker
                                        data-color={token}
                                        format="oklch"
                                        alpha
                                        value={defaults.light[token]}
                                    />
                                </hx-form-field>
                            ))}
                        </div>
                    </hx-accordion-item>

                    <hx-accordion-item value="radius">
                        <span slot="title">Radius</span>
                        <div class="flex flex-col gap-4">
                            {Object.entries(radii).map(([token, max]) => (
                                <hx-form-field label={`${labelOf(token)} (rem)`}>
                                    <hx-slider
                                        data-token={token}
                                        data-unit="rem"
                                        min="0"
                                        max={max}
                                        step="0.125"
                                        value={Math.min(remOf(token), max)}
                                    />
                                </hx-form-field>
                            ))}
                        </div>
                    </hx-accordion-item>

                    <hx-accordion-item value="sizes">
                        <span slot="title">Sizes and spacing</span>
                        <div class="flex flex-col gap-4">
                            {Object.entries(sizes).map(([token, [min, max, step = 0.25]]) => (
                                <hx-form-field label={`${labelOf(token)} (rem)`}>
                                    <hx-slider
                                        data-token={token}
                                        data-unit="rem"
                                        min={min}
                                        max={max}
                                        step={step}
                                        value={remOf(token)}
                                    />
                                </hx-form-field>
                            ))}
                            <hx-form-field label="Border width (px)">
                                <hx-slider
                                    data-token="--hx-border-width"
                                    data-unit="px"
                                    min="0"
                                    max="3"
                                    step="1"
                                    value={parseFloat(defaults.light["--hx-border-width"])}
                                />
                            </hx-form-field>
                        </div>
                    </hx-accordion-item>

                    <hx-accordion-item value="typography">
                        <span slot="title">Typography</span>
                        <div class="flex flex-col gap-3">
                            {[presetSelect("font-size")].map(({ preset, label, value, options }) => (
                                <hx-form-field label={label}>
                                    <hx-select data-preset={preset} value={value} placeholder="Custom">
                                        {options.map((option) => (
                                            <hx-select-option value={option}>{capitalize(option)}</hx-select-option>
                                        ))}
                                    </hx-select>
                                </hx-form-field>
                            ))}
                            <FontFamilySelect />
                        </div>
                    </hx-accordion-item>
                </hx-accordion>
            </hx-tab-panel>
        </hx-tabs>

        <div class="absolute top-0 right-0">
            <hx-dropdown class="theme-editor-actions">
                <hx-button slot="trigger" square variant="outline" title="Actions">
                    <hx-icon data-icon="Ellipsis" label="Actions"></hx-icon>
                </hx-button>
                <hx-dropdown-item value="copy" data-icon="Copy">
                    Copy CSS
                </hx-dropdown-item>
                <hx-dropdown-item value="download" data-icon="Download">
                    Download theme.css
                </hx-dropdown-item>
                <hx-dropdown-separator></hx-dropdown-separator>
                <hx-dropdown-item value="reset" variant="destructive" data-icon="RotateCcw">
                    Reset
                </hx-dropdown-item>
            </hx-dropdown>
        </div>
    </div>
</div>

<script>
    import "hexa-ui";
    import type { HxColorPicker } from "hexa-ui";
    import { toggleColorMode } from "hexa-ui/color-mode";
    import css from "hexa-ui/theme.css?raw";
    import { icons } from "lucide";
    import { parseTheme, themeStorageKey, themeToCss, type Theme, type ThemeMode } from "../theme";
    import { baseColorTheme, baseColors, primaryColorTheme, primaryColors, tokenPresets } from "../theme-presets";

    type ValueElement = HTMLElement & { value: string };

    const defaults = parseTheme(css);
    const editors = [...document.querySelectorAll<HTMLElement>(".theme-editor")];
    const primaryTokens = ["--hx-primary", "--hx-primary-foreground"];

    let theme: Theme = { light: {}, dark: {} };
    try {
        theme = parseTheme(localStorage.getItem(themeStorageKey) ?? "");
    } catch {}

    function capitalize(text: string) {
        return text[0].toUpperCase() + text.slice(1);
    }

    function currentMode(): ThemeMode {
        return document.documentElement.classList.contains("dark") ? "dark" : "light";
    }

    function valueOf(mode: ThemeMode, token: string) {
        return theme[mode][token] ?? defaults[mode][token] ?? defaults.light[token];
    }

    function setColor(token: string, value: string) {
        const mode = currentMode();
        const other = mode === "light" ? "dark" : "light";
        theme[other][token] ??= valueOf(other, token);
        theme[mode][token] = value;
        apply();
    }

    function setPreset(preset: Theme) {
        for (const [token, value] of Object.entries(preset.light)) {
            if (value === defaults.light[token]) delete theme.light[token];
            else theme.light[token] = value;
        }
        for (const [token, value] of Object.entries(preset.dark)) {
            if (value === defaults.dark[token] && !(token in theme.light)) delete theme.dark[token];
            else theme.dark[token] = value;
        }
    }

    function setTokens(tokens: Record<string, string>) {
        for (const [token, value] of Object.entries(tokens)) {
            if (value === defaults.light[token]) delete theme.light[token];
            else theme.light[token] = value;
        }
        apply();
    }

    function primaryOf(preset: Theme): Theme {
        const pick = (tokens: Record<string, string>) =>
            Object.fromEntries(primaryTokens.map((token) => [token, tokens[token]]));
        return { light: pick(preset.light), dark: pick(preset.dark) };
    }

    function matches(preset: Theme, ignored: string[] = []) {
        return (["light", "dark"] as ThemeMode[]).every((mode) =>
            Object.entries(preset[mode]).every(
                ([token, value]) => ignored.includes(token) || valueOf(mode, token) === value,
            ),
        );
    }

    function baseColorOf() {
        return baseColors.find((name) => matches(baseColorTheme(name), primaryTokens));
    }

    function primaryColorOf() {
        const base = baseColorOf();
        if (base && matches(baseColorTheme(base))) return "default";
        return primaryColors.find((name) => matches(primaryColorTheme(name)));
    }

    function tokenPresetOf(preset: string) {
        const options = tokenPresets[preset];
        return Object.keys(options).find((name) =>
            Object.entries(options[name]).every(([token, value]) => valueOf("light", token) === value),
        );
    }

    function apply() {
        const css = themeToCss(theme);
        document.getElementById("hx-docs-theme")!.textContent = css;
        try {
            if (css) localStorage.setItem(themeStorageKey, css);
            else localStorage.removeItem(themeStorageKey);
        } catch {}
        editors.forEach(sync);
    }

    function sync(editor: HTMLElement) {
        const mode = currentMode();
        editor.querySelector<ValueElement>(".theme-editor-mode")!.value = mode;
        const base = baseColorOf();
        editor.querySelector<ValueElement>(".theme-editor-base-color")!.value = base ?? "";
        editor.querySelector(".theme-editor-primary-color [value=default]")!.textContent = capitalize(
            base ?? "neutral",
        );
        editor.querySelector<ValueElement>(".theme-editor-primary-color")!.value = primaryColorOf() ?? "";
        for (const select of editor.querySelectorAll<ValueElement>("[data-preset]")) {
            select.value = tokenPresetOf(select.dataset.preset!) ?? "";
        }
        for (const picker of editor.querySelectorAll<HxColorPicker>("[data-color]")) {
            picker.value = valueOf(mode, picker.dataset.color!);
        }
        for (const control of editor.querySelectorAll<HTMLElement & { value: unknown; max: number }>("[data-token]")) {
            const value = valueOf("light", control.dataset.token!);
            control.value = control.dataset.unit ? Math.min(parseFloat(value), control.max) : value;
        }
        const empty = !themeToCss(theme);
        for (const item of editor.querySelectorAll<HTMLElement & { disabled: boolean }>(
            ".theme-editor-actions :is([value=copy], [value=download])",
        )) {
            item.disabled = empty;
        }
    }

    function download() {
        const link = document.createElement("a");
        link.href = URL.createObjectURL(new Blob([themeToCss(theme)], { type: "text/css" }));
        link.download = "theme.css";
        link.click();
        URL.revokeObjectURL(link.href);
    }

    for (const editor of editors) {
        editor.querySelector(".theme-editor-mode")!.addEventListener("hx-tab-change", (event) => {
            if ((event as CustomEvent<{ value: ThemeMode }>).detail.value !== currentMode()) toggleColorMode();
        });

        const baseColor = editor.querySelector<ValueElement>(".theme-editor-base-color")!;
        baseColor.addEventListener("change", () => {
            const primary = primaryColorOf();
            setPreset(baseColorTheme(baseColor.value));
            if (primary && primary !== "default") setPreset(primaryColorTheme(primary));
            apply();
        });

        const primaryColor = editor.querySelector<ValueElement>(".theme-editor-primary-color")!;
        primaryColor.addEventListener("change", () => {
            setPreset(
                primaryColor.value === "default"
                    ? primaryOf(baseColorTheme(baseColorOf() ?? "neutral"))
                    : primaryColorTheme(primaryColor.value),
            );
            apply();
        });

        for (const select of editor.querySelectorAll<ValueElement>("[data-preset]")) {
            select.addEventListener("change", () => setTokens(tokenPresets[select.dataset.preset!][select.value]));
        }

        for (const picker of editor.querySelectorAll<HxColorPicker>("[data-color]")) {
            picker.addEventListener("input", () => setColor(picker.dataset.color!, picker.value));
        }

        for (const control of editor.querySelectorAll<HTMLElement & { value: unknown }>("[data-token]")) {
            const unit = control.dataset.unit;
            control.addEventListener(unit ? "input" : "change", () => {
                setTokens({ [control.dataset.token!]: unit ? `${control.value}${unit}` : String(control.value) });
            });
        }

        for (const element of editor.querySelectorAll<HTMLElement & { icon?: unknown }>("[data-icon]")) {
            element.icon = icons[element.dataset.icon as keyof typeof icons];
        }

        editor.querySelector(".theme-editor-actions")!.addEventListener("hx-select", (event) => {
            const { value } = (event as CustomEvent<{ value: string }>).detail;
            if (value === "copy") navigator.clipboard.writeText(themeToCss(theme));
            else if (value === "download") download();
            else if (value === "reset") {
                theme = { light: {}, dark: {} };
                apply();
            }
        });

        sync(editor);
        editor.dataset.ready = "";
    }

    new MutationObserver(() => editors.forEach(sync)).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
    });
</script>
