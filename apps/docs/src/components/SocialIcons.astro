---
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { Palette } from "lucide";
---

<Default />
<a
    href="/theme/"
    class="sl-flex m-[-0.5em] p-[0.5em] text-(--sl-color-text-accent) hover:text-(--sl-color-white)"
    title="Theme builder"
>
    <span class="sr-only">Theme builder</span>
    <svg
        aria-hidden="true"
        width="1em"
        height="1em"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        {Palette.map(([Tag, attributes]) => (
            <Tag {...attributes} />
        ))}
    </svg>
</a>
